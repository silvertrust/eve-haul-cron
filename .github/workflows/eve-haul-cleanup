
name: EVE Haul Cleanup

on:
  schedule:
    - cron: '0 */3 * * *'
  workflow_dispatch:

jobs:
  cleanup:
    runs-on: ubuntu-latest

    steps:
      - name: Run cleanup
        run: |
          curl --fail-with-body --silent --show-error \
            --max-time 120 \
            "https://eve-houl.byethost15.com//wp-json/eve-haul/v1/market/cleanup?key=${{ secrets.EVE_HAUL_CRON_KEY }}"
